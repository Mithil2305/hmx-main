# HMX FPV Tours - Firebase Configuration
# ========================================
# Copy this file to .env and fill in your Firebase credentials
# Get these from your Firebase Console > Project Settings > Service Accounts

# Flask Configuration
SECRET_KEY=your-secret-key-change-in-production

# Firebase Service Account Configuration
# Download the service account JSON from Firebase Console and use the values below
# OR paste the entire JSON content as FIREBASE_SERVICE_ACCOUNT_JSON

FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\nMultiple lines\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project-id.iam.gserviceaccount.com

# Alternative: Paste the entire service account JSON as a single line
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Frontend URLs (for CORS)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001

# Email Configuration (optional - for production)
SMTP_SERVER=smtp.hostinger.com
SMTP_PORT=587
USE_TLS=true
EMAIL_ADDRESS=your-email@example.com

EMAIL_PASSWORD=your-email-password

# Payment Gateway (optional - for production)
PHONEPE_MERCHANT_ID=your-merchant-id
PHONEPE_SALT_KEY=your-salt-key
PHONEPE_SALT_INDEX=1
PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
PHONEPE_REDIRECT_URL=http://localhost:5173/payment/callback

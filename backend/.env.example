# Email Configuration for HMX FPV Tours
# Copy this file to .env and fill in your actual email credentials

# SMTP Server Configuration
SMTP_SERVER=smtp.hostinger.com
SMTP_PORT=587
USE_TLS=true

# Email Credentials
EMAIL_ADDRESS=authentication@hmxhub.com
EMAIL_PASSWORD=Vps@Server+1974


# For Gmail:
# 1. Enable 2-Factor Authentication on your Google account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use the App Password (not your regular password) in EMAIL_PASSWORD

# For other email providers:
# - Outlook/Hotmail: smtp.live.com, port 587
# - Yahoo: smtp.mail.yahoo.com, port 587
# - Custom SMTP: Use your provider's settings

# PhonePe Configuration (if using payment gateway)
PHONEPE_MERCHANT_ID=your-merchant-id
PHONEPE_SALT_KEY=your-salt-key
PHONEPE_SALT_INDEX=1
PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
PHONEPE_REDIRECT_URL=http://localhost:5173/payment/callback

# Database Configuration
DATABASE_PATH=hmx.db

# Security
SECRET_KEY=your-secret-key-change-in-production

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000


FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\nMultiple lines\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project-id.iam.gserviceaccount.com

